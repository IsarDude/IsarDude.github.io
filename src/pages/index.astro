---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Lukas Fritsch — Portfolio">
  <section>
    <h1>Hallo, ich bin Lukas 👋</h1>
    <p>
      Ich baue Software und dokumentiere meine Projekte hier. Schau dir gerne meine
      <a href={`${base}/projekte`}>Projekte</a> an oder lies im <a href={`${base}/blog`}>Blog</a>.
    </p>
  </section>

  <section>
    <h2>Ausgewählte Projekte</h2>
    {projects.length === 0 && <p class="meta">Noch keine Projekte veröffentlicht.</p>}
    {projects.map((project) => (
      <article class="card">
        <h3><a href={`${base}/projekte/${project.id}`}>{project.data.title}</a></h3>
        <p>{project.data.description}</p>
        <div>
          {project.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      </article>
    ))}
    <p><a href={`${base}/projekte`}>Alle Projekte ansehen →</a></p>
  </section>
</BaseLayout>
