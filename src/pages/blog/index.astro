---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Blog — Lukas Fritsch">
  <h1>Blog</h1>
  {posts.length === 0 && <p class="meta">Noch keine Beiträge veröffentlicht.</p>}
  {posts.map((post) => (
    <article class="card">
      <h3><a href={`${base}/blog/${post.id}`}>{post.data.title}</a></h3>
      <p class="meta">
        {post.data.pubDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <p>{post.data.description}</p>
      <div>
        {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    </article>
  ))}
</BaseLayout>
